{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card" style="max-width: 520px;">
        <div class="cx-card__header">
            <h2>{{ location ? t('locations.edit_title') : t('locations.new') }}</h2>
        </div>
        <div class="cx-card__body">
            <form method="post" action="{{ base_url }}/locations{{ location ? '/' ~ location.id : '/create' }}">
                <div class="mb-3">
                    <label for="warehouse_id" class="form-label">{{ t('common.warehouse') }}</label>
                    <select id="warehouse_id" name="warehouse_id" class="form-select" required>
                        <option value="">{{ t('locations.choose_warehouse') }}</option>
                        {% for w in warehouses %}
                            <option value="{{ w.id }}" {{ location and location.warehouse_id == w.id ? 'selected' : '' }}>{{ w.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="mb-3">
                    <label for="code" class="form-label">{{ t('locations.code') }}</label>
                    <input type="text" id="code" name="code" class="form-control" placeholder="pl. A-01-03" value="{{ location.code|default('') }}" required>
                    <div class="form-text">{{ t('locations.code_hint')|raw }}</div>
                </div>
                <div class="mb-3">
                    <label for="name" class="form-label">{{ t('locations.name') }} <span class="text-muted small">{{ t('common.optional') }}</span></label>
                    <input type="text" id="name" name="name" class="form-control" value="{{ location.name|default('') }}">
                </div>
                <div class="form-check form-switch mb-4">
                    <input type="checkbox" id="is_active" name="is_active" class="form-check-input" {{ (location is null or location.is_active) ? 'checked' : '' }}>
                    <label for="is_active" class="form-check-label">{{ t('common.active') }}</label>
                </div>
                <button type="submit" class="btn btn-primary">{{ t('common.save') }}</button>
                <a href="{{ base_url }}/locations" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
            </form>
        </div>
    </div>
{% endblock %}
