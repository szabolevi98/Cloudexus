{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>API dokumentáció</h2>
            <a href="{{ base_url }}/API.md" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-filetype-md me-1"></i>Nyers markdown megnyitása
            </a>
        </div>
        <div class="cx-card__body">
            <div id="markdown-content" class="markdown-body">
                <p class="text-muted">Betöltés…</p>
            </div>
        </div>
    </div>

    <script src="{{ base_url }}/assets/vendor/marked/marked.min.js"></script>
    <script>
        (function () {
            const target = document.getElementById('markdown-content');
            fetch('{{ base_url }}/API.md')
                .then((r) => r.text())
                .then((md) => { target.innerHTML = marked.parse(md); })
                .catch(() => {
                    target.innerHTML = '<p class="text-danger">A dokumentáció nem tölthető be. Nézd meg a nyers markdown fájlt.</p>';
                });
        })();
    </script>
{% endblock %}
