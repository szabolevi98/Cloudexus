{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('purchase_orders.new_full') }}</h2>
        </div>
        <div class="cx-card__body">
            <form method="post" action="{{ base_url }}/purchase-orders/create" id="order-form">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">{{ t('purchase_orders.order_number') }}</label>
                        <input type="text" name="po_number" class="form-control" value="{{ po_number }}" readonly>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label for="partner_id" class="form-label">{{ t('purchase_orders.supplier') }}</label>
                        <select id="partner_id" name="partner_id" class="form-select cx-ajax-select"
                                data-url="{{ base_url }}/partners/search?role=supplier" data-placeholder="{{ t('purchase_orders.choose_supplier') }}" required></select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">{{ t('purchase_orders.order_date') }}</label>
                        <input type="date" name="order_date" class="form-control" value="{{ "now"|date("Y-m-d") }}">
                    </div>
                </div>

                {% include 'common/line-items.twig' %}

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="{{ base_url }}/purchase-orders" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>{{ t('purchase_orders.create_order') }}
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
