{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card" style="max-width: 640px;">
        <div class="cx-card__header">
            <h2>{{ t('settings.company_title') }}</h2>
        </div>
        <div class="cx-card__body">
            <p class="text-muted small mb-4">{{ t('settings.company_intro') }}</p>
            <form method="post" action="{{ base_url }}/settings/company">
                <div class="mb-3">
                    <label for="name" class="form-label">{{ t('settings.company_name') }}</label>
                    <input type="text" id="name" name="name" class="form-control" value="{{ company.name }}" required>
                </div>
                <div class="mb-3">
                    <label for="address" class="form-label">{{ t('settings.address') }}</label>
                    <input type="text" id="address" name="address" class="form-control" value="{{ company.address }}">
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="tax_number" class="form-label">{{ t('settings.tax_number') }}</label>
                        <input type="text" id="tax_number" name="tax_number" class="form-control" value="{{ company.tax_number }}">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="bank_account" class="form-label">{{ t('settings.bank_account') }}</label>
                        <input type="text" id="bank_account" name="bank_account" class="form-control" value="{{ company.bank_account }}">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="email" class="form-label">{{ t('settings.email') }}</label>
                        <input type="email" id="email" name="email" class="form-control" value="{{ company.email }}">
                    </div>
                    <div class="col-md-6 mb-4">
                        <label for="phone" class="form-label">{{ t('settings.phone') }}</label>
                        <input type="text" id="phone" name="phone" class="form-control" value="{{ company.phone }}">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary">{{ t('common.save') }}</button>
            </form>
        </div>
    </div>
{% endblock %}
