{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <h2>{{ t('incoming_invoices.new') }}</h2>
        </div>
        <div class="cx-card__body">
            {% if from_order %}
                <div class="alert alert-info d-flex align-items-center">
                    <i class="bi bi-info-circle me-2"></i>
                    {{ t('incoming_invoices.from_order_prefilled', {number: from_order.po_number}) }}
                </div>
            {% endif %}
            <form method="post" action="{{ base_url }}/incoming-invoices/create" id="invoice-form">
                {% if from_order %}
                    <input type="hidden" name="purchase_order_id" value="{{ from_order.id }}">
                {% endif %}
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">{{ t('incoming_invoices.invoice_number') }}</label>
                        <input type="text" name="invoice_number" class="form-control" value="{{ invoice_number }}" readonly>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label for="partner_id" class="form-label">{{ t('incoming_invoices.supplier') }}</label>
                        <select id="partner_id" name="partner_id" class="form-select cx-ajax-select"
                                data-url="{{ base_url }}/partners/search?role=supplier" data-placeholder="{{ t('incoming_invoices.choose_supplier') }}" required>
                            {% for opt in partner_option|default([]) %}
                                <option value="{{ opt.id }}" selected>{{ opt.text }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">{{ t('incoming_invoices.issue_date_label') }}</label>
                        <input type="date" name="issue_date" class="form-control" value="{{ "now"|date("Y-m-d") }}">
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">{{ t('incoming_invoices.due_date') }}</label>
                        <input type="date" name="due_date" class="form-control" value="{{ "now"|date_modify("+8 days")|date("Y-m-d") }}">
                    </div>
                </div>
                <div class="mb-3" style="max-width: 320px;">
                    <label for="warehouse_id" class="form-label">
                        {{ t('incoming_invoices.warehouse_stockin') }}
                        <span class="text-muted small">{{ t('common.optional') }}</span>
                    </label>
                    <select id="warehouse_id" name="warehouse_id" class="form-select">
                        <option value="">{{ t('incoming_invoices.no_auto_receipt') }}</option>
                        {% for w in warehouses %}
                            <option value="{{ w.id }}">{{ w.name }}</option>
                        {% endfor %}
                    </select>
                    <div class="form-text">{{ t('incoming_invoices.warehouse_hint') }}</div>
                </div>

                {% include 'common/line-items.twig' with {
                    prefill: from_order ? from_order.items|map(i => {product_id: i.product_id, quantity: i.quantity, unit_price: i.unit_price, text: i.sku ~ ' — ' ~ i.product_name}) : []
                } %}

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="{{ base_url }}/incoming-invoices" class="btn btn-outline-secondary">{{ t('common.cancel') }}</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>{{ t('incoming_invoices.create_invoice') }}
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
