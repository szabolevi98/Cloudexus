{% extends 'common/layout.twig' %}

{% block content %}
    <div class="cx-card">
        <div class="cx-card__header">
            <div>
                <h2>{{ invoice.invoice_number }}</h2>
                <div class="text-muted small">
                    {{ invoice.partner_name }}
                    {% if invoice.tax_number %} · {{ t('invoices.tax_number') }}: {{ invoice.tax_number }}{% endif %}
                </div>
            </div>
            <div>
                {% if invoice.status == 'unpaid' %}
                    <span class="badge rounded-pill text-bg-warning-subtle text-warning-emphasis">{{ t('common.invoice_status.unpaid') }}</span>
                {% elseif invoice.status == 'paid' %}
                    <span class="badge rounded-pill text-bg-success-subtle text-success-emphasis">{{ t('common.invoice_status.paid') }}</span>
                {% else %}
                    <span class="badge rounded-pill text-bg-danger-subtle text-danger-emphasis">{{ t('common.invoice_status.cancelled') }}</span>
                {% endif %}
            </div>
        </div>
        <div class="cx-card__body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="text-muted small">{{ t('invoices.issue_date_label') }}</div>
                    <div class="fw-medium">{{ invoice.issue_date }}</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">{{ t('invoices.due_date') }}</div>
                    <div class="fw-medium">{{ invoice.due_date }}</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">{{ t('invoices.address') }}</div>
                    <div class="fw-medium">{{ invoice.address ?: '—' }}</div>
                </div>
            </div>
        </div>
        <div class="cx-card__body p-0">
            <div class="table-responsive">
                <table class="table cx-table align-middle mb-0">
                    <thead>
                    <tr>
                        <th>{{ t('common.sku') }}</th>
                        <th>{{ t('invoices.product_name') }}</th>
                        <th class="text-end">{{ t('common.quantity') }}</th>
                        <th class="text-end">{{ t('common.unit_price') }}</th>
                        <th class="text-end">{{ t('common.line_total') }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for item in invoice.items %}
                        <tr>
                            <td>{{ item.sku }}</td>
                            <td>{{ item.product_name }}</td>
                            <td class="text-end">{{ item.quantity|number_format(0, ',', ' ') }} {{ item.unit }}</td>
                            <td class="text-end">{{ item.unit_price|money }}</td>
                            <td class="text-end">{{ item.line_total|money }}</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                    <tfoot>
                    {% if invoice.shipping_cost > 0 %}
                        <tr>
                            <td colspan="4" class="text-end text-muted">{{ t('invoices.shipping_cost_row') }}</td>
                            <td class="text-end text-muted">{{ invoice.shipping_cost|money }}</td>
                        </tr>
                    {% endif %}
                    {% if invoice.payment_cost > 0 %}
                        <tr>
                            <td colspan="4" class="text-end text-muted">{{ t('invoices.payment_cost_row') }}</td>
                            <td class="text-end text-muted">{{ invoice.payment_cost|money }}</td>
                        </tr>
                    {% endif %}
                    <tr>
                        <td colspan="4" class="text-end fw-medium">{{ t('common.total') }}</td>
                        <td class="text-end fw-bold">{{ invoice.total_amount|money }}</td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <a href="{{ base_url }}/invoices" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>{{ t('common.back_to_list') }}
        </a>
        <a href="{{ base_url }}/invoices/{{ invoice.id }}/print" target="_blank" class="btn btn-outline-secondary">
            <i class="bi bi-printer me-1"></i>{{ t('common.print') }}
        </a>
        {% if invoice.status == 'unpaid' %}
            <form method="post" action="{{ base_url }}/invoices/{{ invoice.id }}/mark-paid">
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i>{{ t('invoices.mark_paid') }}
                </button>
            </form>
            <form method="post" action="{{ base_url }}/invoices/{{ invoice.id }}/cancel" onsubmit="return confirm('{{ t('invoices.confirm_void')|e('js') }}');">
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle me-1"></i>{{ t('invoices.void') }}
                </button>
            </form>
        {% endif %}
    </div>
{% endblock %}
