<!DOCTYPE html>
<html lang="{{ current_locale }}">
<head>
    <meta charset="UTF-8">
    <title>{{ invoice.invoice_number }} — {{ t('invoices.print_doc_title') }}</title>
    <link rel="icon" href="{{ base_url }}/assets/favicon.svg" type="image/svg+xml">
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: "Segoe UI", system-ui, sans-serif;
            color: #1c2333;
            margin: 0;
            background: #f2f4fb;
        }
        .sheet {
            max-width: 800px;
            margin: 24px auto;
            background: #fff;
            padding: 48px;
            box-shadow: 0 8px 24px rgba(29, 33, 70, 0.08);
        }
        .doc-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px; }
        .doc-header h1 { font-size: 1.6rem; margin: 0 0 4px; color: #4f5bd5; }
        .doc-header .number { font-size: 1.05rem; font-weight: 600; }
        .parties { display: flex; gap: 32px; margin-bottom: 32px; }
        .party { flex: 1; }
        .party h2 { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: #7c8494; margin: 0 0 6px; }
        .party .name { font-weight: 700; margin-bottom: 2px; }
        .party div { font-size: 0.9rem; line-height: 1.45; }
        .meta { display: flex; gap: 24px; margin-bottom: 28px; font-size: 0.9rem; }
        .meta div span { display: block; color: #7c8494; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
        th { text-align: left; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em; color: #7c8494; border-bottom: 2px solid #e7e9f2; padding: 8px 10px; }
        td { padding: 10px; border-bottom: 1px solid #e7e9f2; font-size: 0.92rem; }
        .num { text-align: right; }
        tfoot td { font-weight: 700; font-size: 1.05rem; border-bottom: none; border-top: 2px solid #1c2333; }
        .footer { margin-top: 40px; font-size: 0.8rem; color: #7c8494; text-align: center; }
        .toolbar { max-width: 800px; margin: 16px auto 0; display: flex; gap: 8px; }
        .toolbar a, .toolbar button {
            font: inherit; padding: 8px 18px; border-radius: 8px; cursor: pointer; text-decoration: none;
            border: 1px solid #e7e9f2; background: #fff; color: #1c2333;
        }
        .toolbar button.primary { background: #4f5bd5; border-color: #4f5bd5; color: #fff; }
        @media print {
            body { background: #fff; }
            .sheet { box-shadow: none; margin: 0; max-width: none; padding: 24px; }
            .toolbar { display: none; }
        }
    </style>
</head>
<body>
<div class="toolbar">
    <button type="button" class="primary" onclick="window.print()">🖨 {{ t('common.print') }}</button>
    <a href="{{ base_url }}/invoices/{{ invoice.id }}">« {{ t('invoices.title_prefix') }}</a>
</div>

<div class="sheet">
    <div class="doc-header">
        <div>
            <h1>{{ t('invoices.print_doc_title') }}</h1>
            <div class="number">{{ invoice.invoice_number }}</div>
        </div>
        <div style="text-align:right">
            {% if invoice.status == 'paid' %}
                <div style="color:#1fa971;font-weight:700;">{{ t('invoices.stamp_paid') }}</div>
            {% elseif invoice.status == 'cancelled' %}
                <div style="color:#e0526a;font-weight:700;">{{ t('invoices.stamp_cancelled') }}</div>
            {% endif %}
        </div>
    </div>

    <div class="parties">
        <div class="party">
            <h2>{{ t('invoices.seller') }}</h2>
            <div class="name">{{ company.name|default('—') }}</div>
            <div>{{ company.address|default('') }}</div>
            <div>{{ t('invoices.tax_number') }}: {{ company.tax_number|default('—') }}</div>
            {% if company.bank_account is defined and company.bank_account %}
                <div>{{ t('invoices.bank_account') }}: {{ company.bank_account }}</div>
            {% endif %}
        </div>
        <div class="party">
            <h2>{{ t('invoices.buyer') }}</h2>
            <div class="name">{{ invoice.partner_name }}</div>
            <div>{{ invoice.address|default('') }}</div>
            {% if invoice.tax_number %}
                <div>{{ t('invoices.tax_number') }}: {{ invoice.tax_number }}</div>
            {% endif %}
        </div>
    </div>

    <div class="meta">
        <div><span>{{ t('invoices.issue_date_label') }}</span>{{ invoice.issue_date }}</div>
        <div><span>{{ t('invoices.due_date') }}</span>{{ invoice.due_date }}</div>
        <div><span>{{ t('invoices.payment_method') }}</span>{{ t('invoices.payment_transfer') }}</div>
    </div>

    <table>
        <thead>
        <tr>
            <th>{{ t('common.sku') }}</th>
            <th>{{ t('invoices.product_name') }}</th>
            <th class="num">{{ t('common.quantity') }}</th>
            <th class="num">{{ t('common.unit_price') }}</th>
            <th class="num">{{ t('common.total') }}</th>
        </tr>
        </thead>
        <tbody>
        {% for item in invoice.items %}
            <tr>
                <td>{{ item.sku }}</td>
                <td>{{ item.product_name }}</td>
                <td class="num">{{ item.quantity|number_format(0, ',', ' ') }} {{ item.unit }}</td>
                <td class="num">{{ item.unit_price|money }}</td>
                <td class="num">{{ item.line_total|money }}</td>
            </tr>
        {% endfor %}
        </tbody>
        <tfoot>
        {% if invoice.shipping_cost > 0 %}
            <tr>
                <td colspan="4" class="num" style="font-weight:400;border-top:none;">{{ t('invoices.shipping_cost_row') }}</td>
                <td class="num" style="font-weight:400;border-top:none;">{{ invoice.shipping_cost|money }}</td>
            </tr>
        {% endif %}
        {% if invoice.payment_cost > 0 %}
            <tr>
                <td colspan="4" class="num" style="font-weight:400;border-top:none;">{{ t('invoices.payment_cost_row') }}</td>
                <td class="num" style="font-weight:400;border-top:none;">{{ invoice.payment_cost|money }}</td>
            </tr>
        {% endif %}
        <tr>
            <td colspan="4" class="num">{{ t('invoices.total_due') }}</td>
            <td class="num">{{ invoice.total_amount|money }}</td>
        </tr>
        </tfoot>
    </table>

    <div class="footer">
        {{ t('invoices.print_footer') }} · {{ "now"|date("Y-m-d H:i") }}
    </div>
</div>
</body>
</html>
